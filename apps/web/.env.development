# MVP build: the browser mock API (Mock Service Worker) answers every /api/v1 request (SDD 7, 5.11.2).
VITE_USE_MOCKS=true
# Delivery day shown first: the demo day of the fake sample data (SDD 7.2). Without it: tomorrow.
VITE_DEFAULT_DELIVERY_DAY=2026-11-03
# Map background tiles, loaded by the browser only (SDD 5.6.6).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
